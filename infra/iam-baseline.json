{
  "Policies": [
    {
      "Policy": {
        "Id": "IamPolicyAutopilot",
        "Version": "2012-10-17",
        "Statement": [
          {
            "Effect": "Allow",
            "Action": [
              "dynamodb:ConditionCheckItem",
              "dynamodb:DeleteItem",
              "dynamodb:GetItem",
              "dynamodb:PutItem",
              "dynamodb:ReadDataForReplication",
              "dynamodb:UpdateItem",
              "dynamodb:WriteDataForReplication"
            ],
            "Resource": [
              "arn:*:dynamodb:*:*:table/*"
            ]
          },
          {
            "Effect": "Allow",
            "Action": [
              "kms:Decrypt"
            ],
            "Resource": [
              "arn:*:kms:*:*:key/*"
            ],
            "Condition": {
              "StringLike": {
                "kms:ViaService": [
                  "dynamodb.*.amazonaws.com"
                ]
              }
            }
          },
          {
            "Effect": "Allow",
            "Action": [
              "quicksight:DescribeUser",
              "quicksight:GenerateEmbedUrlForRegisteredUser",
              "quicksight:ListUsers",
              "quicksight:SearchDashboards"
            ],
            "Resource": [
              "arn:*:quicksight:*:*:dashboard/*",
              "arn:*:quicksight:*:*:user/*"
            ]
          }
        ]
      },
      "PolicyType": "Identity"
    }
  ]
}
